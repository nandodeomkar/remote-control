{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-control.local/protocol/messages.schema.json",
  "title": "Remote Control wire protocol — JSON text frames (protoVersion 1.1)",
  "description": "Documentation-grade schema mirroring protocol/SPEC.md §7. Not consumed by code; the golden fixtures in protocol/fixtures/ are the executable contract. Per D-05, decoders IGNORE unknown fields — additionalProperties is deliberately left permissive everywhere.",
  "type": "object",
  "properties": {
    "t": { "type": "string" },
    "seq": { "type": "integer", "description": "Client-assigned, opaque to the server." },
    "p": { "type": "object" }
  },
  "required": ["t"],
  "allOf": [
    {
      "$comment": "protoVersion 1.1 dispatch hook (D-03): the vol.changed push carries a payload with required value+muted. Older types remain doc-grade $defs; retrofitting per-type p dispatch to every family is out of scope.",
      "if": { "properties": { "t": { "const": "vol.changed" } }, "required": ["t"] },
      "then": { "properties": { "p": { "$ref": "#/$defs/volChanged" } } }
    },
    {
      "$comment": "protoVersion 1.8 dispatch hooks (phase 12, D-09): the update.* family mirrors SPEC §7 exactly. update.check has an empty payload and needs no hook.",
      "if": { "properties": { "t": { "const": "update.status" } }, "required": ["t"] },
      "then": { "properties": { "p": { "$ref": "#/$defs/updateStatus" } } }
    },
    {
      "if": { "properties": { "t": { "const": "update.apply" } }, "required": ["t"] },
      "then": { "properties": { "p": { "$ref": "#/$defs/updateApply" } } }
    },
    {
      "if": { "properties": { "t": { "const": "update.progress" } }, "required": ["t"] },
      "then": { "properties": { "p": { "$ref": "#/$defs/updateProgress" } } }
    }
  ],
  "$defs": {
    "hexString64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "64 lowercase hex characters encoding 32 bytes."
    },
    "windowEntry": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "title": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "hello": {
      "description": "C→S. Opens the handshake (SPEC §3).",
      "type": "object",
      "properties": {
        "protoVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "device": { "type": "string" }
      },
      "required": ["protoVersion", "device"]
    },
    "pin": {
      "description": "C→S. Pairing path (SPEC §3a). PIN is a 6-digit zero-padded STRING, never a number.",
      "type": "object",
      "properties": {
        "pin": { "type": "string", "pattern": "^[0-9]{6}$" }
      },
      "required": ["pin"]
    },
    "pairOk": {
      "description": "S→C. The ONLY wire appearance of the raw token (SPEC §12).",
      "type": "object",
      "properties": {
        "token": { "$ref": "#/$defs/hexString64" }
      },
      "required": ["token"]
    },
    "challenge": {
      "description": "S→C. Fresh CSPRNG nonce per connection (SPEC §3).",
      "type": "object",
      "properties": {
        "nonce": { "$ref": "#/$defs/hexString64" }
      },
      "required": ["nonce"]
    },
    "auth": {
      "description": "C→S. mac = HMAC-SHA256(key = SHA-256(raw token), message = nonce bytes), lowercase hex (SPEC §4).",
      "type": "object",
      "properties": {
        "mac": { "$ref": "#/$defs/hexString64" }
      },
      "required": ["mac"]
    },
    "authOk": {
      "description": "S→C. Empty payload; session becomes Authed.",
      "type": "object"
    },
    "authFail": {
      "description": "S→C. Reason enum per SPEC §5.",
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "enum": ["pinInvalid", "pinExpired", "lockedOut", "noPairing", "badMac"]
        },
        "attemptsRemaining": { "type": "integer", "description": "Present iff reason = pinInvalid." },
        "retryAfterSecs": { "type": "integer", "description": "Present iff reason = lockedOut." }
      },
      "required": ["reason"]
    },
    "click": {
      "description": "C→S. Reliable mouse button path.",
      "type": "object",
      "properties": {
        "button": { "type": "string", "enum": ["left", "middle", "right"] }
      },
      "required": ["button"]
    },
    "drag": {
      "description": "C→S. Held state is tracked server-side and released on session end (SPEC §11, CONN-07).",
      "type": "object",
      "properties": {
        "action": { "type": "string", "enum": ["start", "end"] },
        "button": { "type": "string", "enum": ["left", "middle", "right"] }
      },
      "required": ["action", "button"]
    },
    "key": {
      "description": "C→S. Single key with modifiers.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "mods": {
          "type": "array",
          "items": { "type": "string", "enum": ["ctrl", "alt", "shift", "win"] },
          "default": []
        },
        "action": { "type": "string", "enum": ["tap", "down", "up"] }
      },
      "required": ["code", "action"]
    },
    "text": {
      "description": "C→S. Diff-ops: delete bs graphemes (extended grapheme clusters, UAX #29) at end, then insert ins (SPEC §8). Server rejects bs > 10000 with err bsTooLarge.",
      "type": "object",
      "properties": {
        "bs": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "ins": { "type": "string" }
      },
      "required": ["bs", "ins"]
    },
    "media": {
      "description": "C→S. value is required iff action = setvol.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["playpause", "next", "prev", "volup", "voldown", "mute", "setvol"]
        },
        "value": { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "required": ["action"],
      "if": { "properties": { "action": { "const": "setvol" } } },
      "then": { "required": ["action", "value"] }
    },
    "volChanged": {
      "description": "vol.changed — S→C push (SPEC §7, protoVersion 1.1 addition, D-03). Sent after auth and on any server-side volume/mute change. BOTH fields required — a missing field is a hard decode error.",
      "type": "object",
      "properties": {
        "value": { "type": "integer", "minimum": 0, "maximum": 100 },
        "muted": { "type": "boolean" }
      },
      "required": ["value", "muted"]
    },
    "power": {
      "description": "C→S. Requires follow-up confirm within 10s (SPEC §7).",
      "type": "object",
      "properties": {
        "action": { "type": "string", "enum": ["lock", "sleep", "restart", "shutdown"] }
      },
      "required": ["action"]
    },
    "confirm": {
      "description": "C→S. Must match a pending power action within 10s, else err noPendingAction.",
      "type": "object",
      "properties": {
        "action": { "type": "string", "enum": ["lock", "sleep", "restart", "shutdown"] }
      },
      "required": ["action"]
    },
    "appsList": {
      "description": "apps.list — C→S request has empty p; S→C reply carries windows.",
      "type": "object",
      "properties": {
        "windows": { "type": "array", "items": { "$ref": "#/$defs/windowEntry" } }
      }
    },
    "appsLaunch": {
      "description": "apps.launch — C→S.",
      "type": "object",
      "properties": { "path": { "type": "string" } },
      "required": ["path"]
    },
    "appsFocus": {
      "description": "apps.focus — C→S.",
      "type": "object",
      "properties": { "id": { "type": "integer" } },
      "required": ["id"]
    },
    "appsClose": {
      "description": "apps.close — C→S.",
      "type": "object",
      "properties": { "id": { "type": "integer" } },
      "required": ["id"]
    },
    "appsChanged": {
      "description": "apps.changed — S→C push.",
      "type": "object",
      "properties": {
        "windows": { "type": "array", "items": { "$ref": "#/$defs/windowEntry" } }
      },
      "required": ["windows"]
    },
    "clipSet": {
      "description": "clip.set — C↔S (both directions).",
      "type": "object",
      "properties": { "text": { "type": "string" } },
      "required": ["text"]
    },
    "clipGet": {
      "description": "clip.get — C→S; server replies with clip.set.",
      "type": "object"
    },
    "clipChanged": {
      "description": "clip.changed — S→C push (auto-sync).",
      "type": "object",
      "properties": { "text": { "type": "string" } },
      "required": ["text"]
    },
    "browser": {
      "description": "C→S. Key-macro based browser controls.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["back", "forward", "newtab", "closetab", "refresh", "zoomin", "zoomout"]
        }
      },
      "required": ["action"]
    },
    "present": {
      "description": "C→S. Presenter remote.",
      "type": "object",
      "properties": {
        "action": { "type": "string", "enum": ["next", "prev", "start", "end", "blank"] }
      },
      "required": ["action"]
    },
    "ping": {
      "description": "C→S. Latency probe.",
      "type": "object",
      "properties": { "ts": { "type": "integer" } },
      "required": ["ts"]
    },
    "pong": {
      "description": "S→C. Echoes ping ts.",
      "type": "object",
      "properties": { "ts": { "type": "integer" } },
      "required": ["ts"]
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "A unified X.Y.Z release version (D-04). A leading `v` belongs to git tags, not to wire values; a pre-release suffix (X.Y.Z-rcN) is NOT accepted and compares as unknown (D-26)."
    },
    "updateStage": {
      "type": "string",
      "enum": ["checking", "downloading", "verifying", "installing", "restarting", "uptodate", "failed"],
      "description": "CLOSED vocabulary (SPEC §7, D-10). `pct` accompanies `downloading` ONLY. `uptodate` and `failed` are terminal."
    },
    "updateError": {
      "type": "string",
      "enum": ["network", "checksum", "disk", "installer", "downgrade", "stale", "busy"],
      "description": "CLOSED vocabulary (SPEC §7, D-11). Never free text, never a path, never a URL, never an HTTP status, never an exception name — so that no server-side detail can reach the phone through the error channel."
    },
    "updateLastUpdate": {
      "description": "update.status.lastUpdate — the PREVIOUS attempt's outcome, read at startup from the marker file (SPEC §7, D-12). Present only when a marker existed; a missing marker is the normal case, never an error.",
      "type": "object",
      "properties": {
        "target": { "$ref": "#/$defs/semver" },
        "ok": { "type": "boolean" },
        "error": { "$ref": "#/$defs/updateError", "description": "Present only when ok is false." }
      },
      "required": ["target", "ok"]
    },
    "updateCheck": {
      "description": "update.check — C→S, empty payload (SPEC §7, protoVersion 1.8, D-09). Executor-bound despite being a read (SPEC §11, D-13). Reply is update.status.",
      "type": "object"
    },
    "updateStatus": {
      "description": "update.status — S→C reply to update.check (SPEC §7, protoVersion 1.8, D-09). extVersion is ABSENT when the extension has never connected — skipped entirely, never emitted as null.",
      "type": "object",
      "properties": {
        "serverVersion": { "$ref": "#/$defs/semver" },
        "extConnected": { "type": "boolean" },
        "extVersion": { "$ref": "#/$defs/semver" },
        "lastUpdate": { "$ref": "#/$defs/updateLastUpdate" }
      },
      "required": ["serverVersion", "extConnected"]
    },
    "updateApply": {
      "description": "update.apply — C→S (SPEC §7 and §12, protoVersion 1.8, D-09/D-14). `target` is the ONLY field this message carries, now or ever: the server resolves the asset URL and its sha256 itself from a compiled-in repo constant and refuses any locator supplied, implied or influenced by the wire. additionalProperties is false HERE and only here — the D-05 ignore-unknown leniency is permissive everywhere else in this schema, but a wire-supplied locator would be arbitrary code execution on the PC, so this payload is closed by design. Executor-bound (SPEC §11).",
      "type": "object",
      "properties": {
        "target": { "$ref": "#/$defs/semver" }
      },
      "required": ["target"],
      "additionalProperties": false
    },
    "updateProgress": {
      "description": "update.progress — S→C push (SPEC §7, protoVersion 1.8, D-09/D-10/D-11). Optional fields are skipped entirely when absent, never emitted as null.",
      "type": "object",
      "properties": {
        "stage": { "$ref": "#/$defs/updateStage" },
        "pct": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Present iff stage = downloading (D-10)." },
        "version": { "$ref": "#/$defs/semver" },
        "error": { "$ref": "#/$defs/updateError", "description": "Present iff stage = failed (D-10/D-11)." }
      },
      "required": ["stage"]
    },
    "err": {
      "description": "S→C. Failure report. Codes: versionMismatch (+ serverVersion, clientVersion), unknownType, noPendingAction, bsTooLarge, internal (SPEC §7).",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": ["versionMismatch", "unknownType", "noPendingAction", "bsTooLarge", "internal"]
        },
        "msg": { "type": "string" },
        "serverVersion": { "type": "string", "description": "Present iff code = versionMismatch." },
        "clientVersion": { "type": "string", "description": "Present iff code = versionMismatch." }
      },
      "required": ["code", "msg"]
    }
  }
}
